PORT=8080
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/veggity?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key

# Email Configuration for OTP Verification (Gmail App Password)
# Note: For Gmail, use an "App Password" generated in Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
